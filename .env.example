# Copied to ~/n8n/.env on the server by the scripts; the real values live in
# ~/.config/oracle-n8n/.env on your machine (never in this repo).
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Losing this key = losing every credential saved in n8n. Back it up.
N8N_ENCRYPTION_KEY=

# Optional: public domain through Cloudflare Tunnel (scripts/setup-domain.sh).
# deploy.sh derives N8N_HOST, N8N_PROTOCOL, N8N_EDITOR_BASE_URL, N8N_WEBHOOK_URL,
# N8N_PROXY_HOPS and COMPOSE_PROFILES=tunnel from these two.
N8N_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
